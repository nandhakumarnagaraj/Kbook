##########################
# Repository-wide ignores
# Backend build artifacts
/services/server/target/
/services/server/*.log
/services/server/*.pid

# Backend IDE metadata (Eclipse)
/services/server/.settings/
/services/server/.classpath
/services/server/.factorypath
/services/server/.project

# Java class files (just in case another directory sneaks them in)
*.class
*.exe
*.dll

# Android local/generated files
/apps/android/*.log
/apps/android/local.properties
/apps/android/.gradle/
/apps/android/.kotlin/
/apps/android/build/

# Editor temp files
*.swp
*.swo
*~

# DB backups (contain sensitive customer/transaction data)
backups/

# Node.js
node_modules/
services/server/.env*
!services/server/.env.example
.env
.env.bak-*
.env.v2
!.env.example

# Android secrets (use secrets.properties.example as template)
apps/android/secrets.properties
apps/android/local.properties
apps/android/release-key.jks
apps/android/app/google-services.json

# Android app build outputs
apps/android/app/build/
apps/android/app/*.apk
apps/android/app/*.aab
apps/android/*.aab

# Python scripts (one-time utilities)
*.py
!ops/*.py

# Local dev CDN uploads (not for VCS)
/cdn/

# AI agent & tooling local data (never commit)
.claude/
.agents/
# Agent tooling trees at repo root (skills, hooks, local settings, bundled
# binaries). Kept local like the dot-directories above, never committed.
/agent/
/agents/
.agnes/
.codex/
.opencode/
.kiro/
.specify/
.freebuff/
# Root-level tooling only — docs/specs/ is real, tracked documentation.
# /mcp/ is tracked on purpose: a config that points at a package nobody can
# install (e.g. the 404 ui-ux-pro-max entry) stays broken for every machine as
# long as it only exists locally. docs/mcp/ remains the human-facing index.
/specs/
opencode.json
/CONTEXT.md

# Editor/IDE local settings
.vscode/

# GitHub local directory (agents, skills, hooks stay local) — but workflows ARE
# tracked: CI gates every push/PR (see .github/workflows/ci.yml)
/.github/*
!/.github/workflows/

# Local test data file
dev_test

# Skill lock files
skills-lock.json

# Empty log placeholders
server-run.log
server-run.err
web-admin-run.log
web-admin-run.err

# macOS
.DS_Store
**/.DS_Store

# Windows
Thumbs.db

# Android Studio root-project metadata generated when the repo root is opened
*.iml
/.idea/.gitignore
/.idea/AndroidProjectSystem.xml
/.idea/Kbook.iml
/.idea/caches/
/.idea/deploymentTargetSelector.xml
/.idea/markdown.xml
/.idea/misc.xml
/.idea/modules.xml
/.idea/runConfigurations.xml
/.idea/vcs.xml
/.idea/workspace.xml
/services/server/*.err
/services/server/*.out
/logs/

# All server versioned log files (server-v3.log through server-v99.log)
services/server/server-v*.log
services/server/server-v*.err
services/server/server-v*.out
services/server/server-current*.log
services/server/server-current*.err
services/server/server-new*.log
services/server/server-new*.err
services/server/server-local*.log
services/server/server-local*.err
services/server/server-debug.log
services/server/server-test.log
services/server/server-error.log
services/server/server-startup.log
services/server/startup.log
services/server/app.log
services/server/..server-output.log

# Root-level log/err files generated by local server runs
server-output.log
server-start.log
web-admin-start.log
web-admin-output.log

# Android APK build outputs
/apps/android/apk-output/
/artifacts/android/*.apk

/apps/web-admin/dist/
# Root-level web-admin/ is local-only state: the LIVE docroot served by nginx/Apache
# plus node_modules and .angular caches. Zero tracked files live under it.
/web-admin/
# Other root-level local-only state: a stray Android/ build tree, a stray server/
# working dir (logs, target/, uploads) and AI session transcripts.
/Android/
/server/
/session-*.md
# Root-level manifests only — the real ones live in apps/web-admin and must stay tracked.
/package-lock.json
/package.json

# Local Maven distribution (not needed in VCS)
/maven/
/maven.zip

# Test files
test.html

# Generated analysis and scratch output
/graphify-out/
/scratch/
/brag-output/

# Duplicate static export folder; active web assets live in web-admin/public/
/website/

# Claude Code local session data

nul
apps/android/nul

# Antigravity agents & local builds
apps/android/*.apk

# Firebase Private Keys (must not be committed to VCS)
firebase-service-account.json

# Root-level screenshots and QA captures (use ops/ or docs/ subdir if intentional)
/*.png
/*.jpg
/*.jpeg

# Temp working docs / scratch files at repo root
_build.ps1
_placeholder.txt
run_build.cmd
FIX_PLAN.md
Production_docs.txt
KHANABOOK_API_REVIEW_VALIDATION_*.md

# ─── Additional repo-cleanup entries (2026-08-21) ───

# Root-level IDE directory (catch-all for .idea/)
.idea/

# Android Studio IDE metadata inside the Android subproject
apps/android/.idea/

# All log files anywhere in the repo
*.log

# Java keystore files (secrets — should never be committed)
*.jks
apps/android/app/khanabook-release-key.jks

# Temporary commit message file
.commit_temp
.aider*

# Serena MCP local state (symbol cache, per-project config, agent memories)
.serena/
