<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Android 13+ (API 33) addition: always show the icon on splash,
        even when launched from a notification or shortcut.
        
        NOTE: This overrides values-v31/themes.xml — keep both files in sync.
    -->
    <style name="Theme.KhanaBookLite.Launch" parent="Theme.SplashScreen">
        <!-- Inherit all from v31, just add the behavior attribute -->
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.KhanaBookLite</item>

        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>

        <item name="android:windowBackground">@drawable/launch_screen_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
