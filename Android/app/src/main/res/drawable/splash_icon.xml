<?xml version="1.0" encoding="utf-8"?>
<!--
    System splash icon (API 31+).
    Calibrated to 150dp x 150dp (1:1 square) perfectly centered inside the 160dp circular safe area.
    Matches the Compose BrandedStartFrame logo dimensions pixel-for-pixel with zero clipping and zero jump.
-->
