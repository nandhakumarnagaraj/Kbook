<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash icon for the Android 12+ SplashScreen API.

    Uses @drawable/splash_logo - a transparent-background copy of the brand mark
    generated by ops/make_transparent_splash_logo.ps1. The original
    khanabook_logo.png and ic_launcher_foreground.png both ship with an opaque
    white background, which the platform rendered as a white block behind the icon.

    The platform draws this on a 240x240dp canvas but only the inner 160x160dp
    circle is visible, so the mark is inset to stay inside that safe zone.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_logo"
    android:insetLeft="15%"
    android:insetTop="15%"
    android:insetRight="15%"
    android:insetBottom="15%" />
