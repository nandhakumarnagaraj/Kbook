<?xml version="1.0" encoding="utf-8"?>
<!--
    System splash icon for AndroidX SplashScreen API.
    
    Smaller inset (25%) so the logo appears modest on the system splash.
    When BrandedStartFrame appears with the larger logo + text + glow,
    it feels like a natural brand reveal rather than a jarring swap.
    
    The background gradient (launch_screen_background.xml) matches
    BrandedStartFrame's gradient exactly for seamless color continuity.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_logo"
    android:insetLeft="25%"
    android:insetTop="25%"
    android:insetRight="25%"
    android:insetBottom="25%" />
