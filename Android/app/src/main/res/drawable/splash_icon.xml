<?xml version="1.0" encoding="utf-8"?>
<!--
    System splash icon — intentionally transparent/empty.

    The system splash shows ONLY the burgundy gradient background
    (launch_screen_background.xml). The branded logo, title, and footer
    appear in BrandedStartFrame which renders immediately after.

    This eliminates the "double splash" perception caused by a small
    circle-masked logo (system) followed by a large logo with text (Compose).
    Instead, the user sees: dark background → branded splash → app.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@android:color/transparent"
    android:insetLeft="0%"
    android:insetTop="0%"
    android:insetRight="0%"
    android:insetBottom="0%" />
