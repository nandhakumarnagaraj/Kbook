<?xml version="1.0" encoding="utf-8"?>
<!--
    Cold-start window background.

    Gradient only — the splash icon (windowSplashScreenAnimatedIcon) carries the
    logo, so there is a single authoritative branded splash with no logo double-draw.

    Palette exactly matches the branded splash reference AND the custom branded
    frame (BrandedStartFrame: top #170207 → middle #2D0A10 → bottom #150206) so
    on Android 8-11 the launch window blends invisibly into the branded frame,
    and the Android 12+ solid splash background (splash_bg #1F060A) sits within
    the same burgundy range.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#170207"
                android:centerColor="#2D0A10"
                android:endColor="#150206" />
        </shape>
    </item>
</layer-list>
