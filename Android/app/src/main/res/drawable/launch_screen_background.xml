<?xml version="1.0" encoding="utf-8"?>
<!--
    Window background for the launch theme.
    Matches the Compose BrandedStartFrame gradient exactly so there is
    zero visual flash when transitioning from native splash → Compose.
    
    Colors: DarkBrown1 (#1A0A0A) → DarkBrown2 (#2D1010) → RichEspresso (#1A0828)
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1A0A0A"
                android:centerColor="#2D1010"
                android:endColor="#1A0828" />
        </shape>
    </item>
</layer-list>
