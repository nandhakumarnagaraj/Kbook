<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.KhanaBookLite" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:elegantTextHeight">false</item>
        <item name="android:windowBackground">@drawable/launch_screen_background</item>
    </style>

    <!--
        Launch theme for Android 8-11 (API 26-30).
        These versions have no SplashScreen API, so the cold-start window simply
        shows windowBackground - the gradient with the centered logo.

        Android 12+ (API 31+) overrides this in res/values-v31/themes.xml.
    -->
    <style name="Theme.KhanaBookLite.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.KhanaBookLite</item>

        <item name="android:windowBackground">@drawable/launch_screen_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
