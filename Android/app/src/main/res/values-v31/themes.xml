<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Android 12+ (API 31+) splash screen.

        Single authoritative branded splash: windowSplashScreenAnimatedIcon carries
        the logo on the splash background; the window background is gradient-only
        so there is no second branded frame.
    -->
    <style name="Theme.KhanaBookLite.Launch" parent="Theme.SplashScreen">
        <!-- androidx compat attributes -->
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.KhanaBookLite</item>

        <!-- platform attributes (API 31+) — icon is transparent, only gradient shows -->
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>

        <!-- Fill the whole window, including behind the system bars -->
        <item name="android:windowBackground">@drawable/launch_screen_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
