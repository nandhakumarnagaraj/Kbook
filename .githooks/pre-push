#!/bin/sh
# openqodex pre-push hook: openqodex hook uninstall removes it
#
# The installed checker is not always at /root/.openqodex/bin/openqodex (a
# Windows checkout keeps it under the user profile, and CI has none at all), so
# resolve it: PATH first, then the home install, then the pinned release via npx.
if command -v openqodex >/dev/null 2>&1; then
  OPENQODEX=openqodex
elif [ -x "$HOME/.openqodex/bin/openqodex" ]; then
  OPENQODEX="$HOME/.openqodex/bin/openqodex"
else
  OPENQODEX=
fi

if [ -n "$OPENQODEX" ]; then
  output=$("$OPENQODEX" hook pre-push "$@" 2>&1)
  status=$?
else
  output=$(npx -y openqodex@0.16.0 hook pre-push "$@" 2>&1)
  status=$?
fi

printf '%s\n' "$output"

# OpenQodex blocks with exit 1; anything else is a report.
if [ "$status" -eq 1 ]; then
  exit 1
fi

# A review is keyed to the change it saw. If the working tree held uncommitted
# files when it ran, that change includes them, so it can never match a push of
# commits alone — the warning is expected, not a broken receipt. Say which case
# this is instead of leaving a bare "not reviewed".
case "$output" in
  *"has not reviewed this change"*)
    if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
      echo "note: the working tree has uncommitted files, so the reviewed change and this push cannot share an identity."
      echo "      Review again after committing or stashing them to get a matching receipt, or push knowing this report is advisory."
    else
      echo "note: the working tree is clean, so this push really is unreviewed — run 'openqodex review' before pushing."
    fi
    ;;
esac

exit 0
