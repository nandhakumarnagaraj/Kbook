# KhanaBook STAGING environment template.
# Copy to ops/.env.staging on the VPS and fill CHANGE_ME values.
# DO NOT reuse any production secret here. DO NOT commit real secrets.
# This file configures the ISOLATED staging stack only (docker-compose.staging.yml).

# ── Staging database (separate DB + volume; NOT prod kbook_saas / pgdata) ──
POSTGRES_DB=kbook_staging
POSTGRES_USER=kbookstaging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_ONLY

# ── Server ──
# Host bind port for the staging app (prod uses 8081). App listens on 8081 inside the container.
SERVER_PORT=8091
SPRING_PROFILES_ACTIVE=prod
SERVER_FORWARD_HEADERS_STRATEGY=framework

# ── Secrets (generate NEW values — never copy prod) ──
JWT_SECRET=CHANGE_ME_STAGING_JWT_64_CHARS_MINIMUM_DO_NOT_REUSE_PROD_XXXXXXXX
PAYMENT_CRYPTO_SECRET=CHANGE_ME_STAGING_PAYMENT_SECRET_32_BYTES_MIN_XXXX

# ── Public endpoint (Apache/DNS/TLS handled separately, later) ──
APP_BASE_URL=https://staging.kbook.iadv.cloud
CORS_ALLOWED_ORIGINS=https://staging.kbook.iadv.cloud

# ── Easebuzz SANDBOX ONLY — never production keys ──
EASEBUZZ_MERCHANT_KEY=CHANGE_ME_SANDBOX_KEY
EASEBUZZ_SALT=CHANGE_ME_SANDBOX_SALT
EASEBUZZ_PAYMENT_BASE_URL=https://testpay.easebuzz.in
EASEBUZZ_DASHBOARD_BASE_URL=https://testdashboard.easebuzz.in
EASEBUZZ_WIRE_BASE_URL=https://testdashboard.easebuzz.in
EASEBUZZ_WIRE_API_KEY=
EASEBUZZ_RETURN_URL=https://staging.kbook.iadv.cloud/api/v1/payments/easebuzz/return
EASEBUZZ_NOTIFY_URL=https://staging.kbook.iadv.cloud/api/v1/payments/easebuzz/webhook
EASEBUZZ_WEBHOOK_URL=https://staging.kbook.iadv.cloud/api/v1/payments/easebuzz/webhook

# ── Staging storage (separate host dirs; NEVER prod CDN/private paths) ──
CDN_BASE_PATH=/var/www/staging-cdn/restaurants/
CDN_URL_PREFIX=https://staging.kbook.iadv.cloud/cdn/
CDN_TMP_PATH=/var/www/staging-cdn/tmp/
PRIVATE_DOCS_BASE_PATH=/var/www/staging-private/documents/
CWEBP_BIN=cwebp

# ── External integrations: disabled/optional in staging ──
GOOGLE_CLIENT_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_OTP_TEMPLATE_NAME=
FIREBASE_CREDENTIALS_PATH=
EMAIL_ENABLED=false

# ── OpenAPI (handy on staging) ──
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
